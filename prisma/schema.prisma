// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Mood preferences
  moodHistory   MoodHistory[]

  // User content
  favorites     Favorite[]
  watchlists    Watchlist[]
  recommendationCache RecommendationCache[]

  // NextAuth relations
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model MoodHistory {
  id        String   @id @default(cuid())
  userId    String
  mood      String   // Detected mood
  input     String   // User's mood description
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mood_history")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  movieId   Int
  movieData Json     // Store complete movie data as JSON
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("favorites")
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  movieId   Int
  movieData Json     // Store complete movie data as JSON
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("watchlists")
}

model RecommendationCache {
  id               String   @id @default(cuid())
  mood             String   // Mood category
  userId           String?  // Can be null for general mood recommendations
  recommendations  Json     // Store cached recommendations as JSON
  expiresAt        DateTime // Cache expiration time
  createdAt        DateTime @default(now())
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("recommendation_cache")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

    @@map("verification_tokens")
}